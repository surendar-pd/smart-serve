rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function providerProfileRef(uid) {
      return /databases/$(database)/documents/provider_profiles/$(uid);
    }

    function customerProfileRef(uid) {
      return /databases/$(database)/documents/customer_profiles/$(uid);
    }

    function isCustomerParticipant(data) {
      return request.auth != null
        && (
          data.customer == customerProfileRef(request.auth.uid)
          || data.customerId == request.auth.uid
          || data.customerUid == request.auth.uid
          || data.customer == request.auth.uid
        );
    }

    function isProviderParticipant(data) {
      return request.auth != null
        && (
          data.provider == providerProfileRef(request.auth.uid)
          || data.providerId == request.auth.uid
          || data.providerUid == request.auth.uid
          || data.provider == request.auth.uid
        );
    }

    // Services: keep rules simple for this project.
    function isServiceOwner() {
      return request.auth != null
        && request.resource.data.provider == providerProfileRef(request.auth.uid);
    }

    // ── Users collection ──────────────────────────────────────────────
    // Users can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Providers collection ──────────────────────────────────────────
    // Providers can read/write their own document
    // Customers can read any provider (for browsing/booking)
    match /providers/{providerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == providerId;
    }

    // ── Customer profile document + cart (explicit paths for reliable rules) ─
    match /customer_profiles/{customerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == customerId;

      match /cart_items/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == customerId;
      }

      match /favorite_services/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == customerId;
      }
    }

    match /bookings/{bookingId} {
      allow read: if isCustomerParticipant(resource.data) || isProviderParticipant(resource.data);

      allow create: if request.auth != null
        && request.resource.data.customer == customerProfileRef(request.auth.uid);

      allow update: if isCustomerParticipant(resource.data) || isProviderParticipant(resource.data);

      allow delete: if request.auth != null
        && isCustomerParticipant(resource.data)
        && resource.data.status == "pending"
        && request.time < (resource.data.scheduledAt - duration.value(2, 'h'));

      match /messages/{messageId} {
        allow read: if request.auth != null
          && (
            isCustomerParticipant(get(/databases/$(database)/documents/bookings/$(bookingId)).data)
            || isProviderParticipant(get(/databases/$(database)/documents/bookings/$(bookingId)).data)
          );

        allow create: if request.auth != null
          && (
            isCustomerParticipant(get(/databases/$(database)/documents/bookings/$(bookingId)).data)
            || isProviderParticipant(get(/databases/$(database)/documents/bookings/$(bookingId)).data)
          )
          && (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == "pending"
            || get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == "active"
            || get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == "CONFIRMED"
            || get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == "confirmed"
          )
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.timestamp is timestamp;

        allow update, delete: if false;
      }
    }


    // ── Services collection (validated listing docs) ──────────────────
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow create: if isServiceOwner();
      allow update: if request.auth != null
        && resource.data.provider == providerProfileRef(request.auth.uid)
        && request.resource.data.provider == resource.data.provider;
      allow delete: if request.auth != null
        && resource.data.provider == providerProfileRef(request.auth.uid);
    }

    // ── Categories collection ─────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Provider profiles (SmartServe app data) ───────────────────────
    match /provider_profiles/{providerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == providerId;

      match /ratings/{ratingId} {
        allow read: if request.auth != null;

        allow create, update: if request.auth != null
          && request.resource.data.bookingId is string
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.providerId == providerId
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && (
            get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customer
              == customerProfileRef(request.auth.uid)
            || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerId
              == request.auth.uid
            || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customerUid
              == request.auth.uid
            || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.customer
              == request.auth.uid
          )
          && (
            get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.provider
              == providerProfileRef(providerId)
            || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerId
              == providerId
            || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.providerUid
              == providerId
            || get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.provider
              == providerId
          );

        allow delete: if false;
      }
    }

    // ── Legacy / auxiliary collections (replace former catch-all) ───────
    match /cartItems/{docId} {
      allow read, write: if request.auth != null;
    }

    match /bookingPatterns/{docId} {
      allow read, write: if request.auth != null;
    }

    match /devices/{docId} {
      allow read, write: if request.auth != null;
    }

    match /reviews/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
