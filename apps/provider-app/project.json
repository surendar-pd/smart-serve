{
    "name": "provider-app",
    "root": "apps/provider-app",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "cd apps\\provider-app && .\\gradlew assembleDebug"            },
            "outputs": [
                "{projectRoot}/app/build/outputs"
            ]
        },
        "installDebug": {
  "command": "cd apps\\provider-app && .\\gradlew installDebug"
}    }
}